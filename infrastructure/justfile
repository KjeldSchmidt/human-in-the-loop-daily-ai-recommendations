# noise-to-signal infra — run `just` (from this directory) to list recipes
#
# Terraform stacks (full applies, no -target lists):
#   env/shared     — ECR + Route53 zone + ACM (shared across envs)
#   env/<env>/app  — Lambda + Function URL + CloudFront + DNS alias

default:
    @just --list

fmt:
    terraform fmt -recursive .

fmt-check:
    terraform fmt -recursive -check .

lint:
    #!/usr/bin/env bash
    set -euo pipefail
    # Validate stack roots (modules with provider aliases need a root context)
    for root in env/shared modules/ecr modules/web_app; do
      pushd "$root" >/dev/null
      terraform init -reconfigure -backend=false >/dev/null
      terraform validate
      popd >/dev/null
    done

# Shared ECR + DNS (once per account; safe to re-run)
apply-shared:
    #!/usr/bin/env bash
    set -euo pipefail
    pushd env/shared >/dev/null
    terraform init -reconfigure -input=false
    terraform apply -auto-approve -input=false -lock-timeout=5m
    popd >/dev/null

plan-shared:
    #!/usr/bin/env bash
    set -euo pipefail
    pushd env/shared >/dev/null
    terraform init -reconfigure
    terraform plan
    popd >/dev/null

# Per-env app (Lambda + CloudFront). Image tag must already exist in shared ECR.
apply-app tag="latest" env="dev":
    #!/usr/bin/env bash
    set -euo pipefail
    pushd "env/{{env}}/app" >/dev/null
    terraform init -reconfigure -input=false
    terraform apply -auto-approve -input=false -lock-timeout=5m \
      -var="image_tag={{tag}}"
    popd >/dev/null

plan-app tag="latest" env="dev":
    #!/usr/bin/env bash
    set -euo pipefail
    pushd "env/{{env}}/app" >/dev/null
    terraform init -reconfigure
    terraform plan -var="image_tag={{tag}}"
    popd >/dev/null

# shared → push → app → migrate/seed
deploy tag="latest" env="dev":
    just apply-shared
    DEPLOY_ENV={{env}} just push-image "{{tag}}"
    just apply-app "{{tag}}" "{{env}}"
    just setup-remote "{{env}}"

outputs env="dev":
    #!/usr/bin/env bash
    set -euo pipefail
    pushd "env/{{env}}/app" >/dev/null
    terraform init -reconfigure >/dev/null
    terraform output
    url="$(terraform output -raw service_url 2>/dev/null || true)"
    if [[ -n "$url" && "$url" != "null" ]]; then
      echo ""
      echo "APP_URL=${url}"
      echo "Open: ${url}"
    else
      echo ""
      echo "APP_URL=(not deployed — just deploy)"
    fi
    popd >/dev/null

create-databases:
    #!/usr/bin/env bash
    set -euo pipefail
    AWS_PROFILE="${AWS_PROFILE:-AdministratorAccess-465836752303}"
    SECRET_ID="${SECRET_ID:-tck-labs/shared/rds}"
    DATABASES=("noise_to_signal_dev" "noise_to_signal_prod")

    echo "Fetching credentials from Secrets Manager (${SECRET_ID})..."
    SECRET_JSON="$(aws secretsmanager get-secret-value \
      --profile "$AWS_PROFILE" \
      --region eu-central-1 \
      --secret-id "$SECRET_ID" \
      --query SecretString \
      --output text)"
    export SECRET_JSON

    HOST="$(python3 -c 'import json,os; print(json.loads(os.environ["SECRET_JSON"])["host"])')"
    PORT="$(python3 -c 'import json,os; print(json.loads(os.environ["SECRET_JSON"])["port"])')"
    USER="$(python3 -c 'import json,os; print(json.loads(os.environ["SECRET_JSON"])["username"])')"
    PASS="$(python3 -c 'import json,os; print(json.loads(os.environ["SECRET_JSON"])["password"])')"

    if ! command -v psql >/dev/null 2>&1; then
      echo "psql not found. Install PostgreSQL client, then re-run."
      echo "Or connect manually as tckadmin and run:"
      for db in "${DATABASES[@]}"; do
        echo "  CREATE DATABASE ${db};"
      done
      exit 1
    fi

    export PGPASSWORD="$PASS"
    CONN="host=${HOST} port=${PORT} user=${USER} dbname=tcklabs sslmode=require"

    for db in "${DATABASES[@]}"; do
      exists="$(psql "$CONN" -tAc "SELECT 1 FROM pg_database WHERE datname='${db}'")"
      if [[ "$exists" == "1" ]]; then
        echo "Database ${db} already exists — skip"
      else
        echo "Creating database ${db}..."
        psql "$CONN" -v ON_ERROR_STOP=1 -c "CREATE DATABASE ${db};"
        echo "Created ${db}"
      fi
    done

    echo "Done. App DATABASE_URL path must be /noise_to_signal_dev or /noise_to_signal_prod."

upsert-google-oauth:
    python3 scripts/upsert_google_oauth_secret.py

manage *args:
    #!/usr/bin/env bash
    set -euo pipefail
    env="${DEPLOY_ENV:-dev}"
    tf_dir="{{justfile_directory()}}/env/${env}/app"
    fn="$(cd "$tf_dir" && terraform output -raw function_name)"
    payload="$(python3 -c 'import json,sys; print(json.dumps({"manage": sys.argv[1:]}))' {{args}})"
    out="$(mktemp)"
    aws lambda invoke \
      --function-name "$fn" \
      --cli-binary-format raw-in-base64-out \
      --payload "$payload" \
      "$out"
    cat "$out"
    echo
    rm -f "$out"

setup-remote env="dev":
    DEPLOY_ENV={{env}} just manage migrate --noinput
    DEPLOY_ENV={{env}} just manage seed_demo

# ECR URL from shared stack
push-image tag="latest":
    #!/usr/bin/env bash
    set -euo pipefail
    root="$(cd "{{justfile_directory()}}/.." && pwd)"
    tf_dir="{{justfile_directory()}}/env/shared"
    aws_region="${AWS_REGION:-eu-central-1}"
    repo="$(cd "$tf_dir" && terraform output -raw ecr_repository_url)"

    aws_cli=(aws)
    if [[ -n "${AWS_PROFILE:-}" ]]; then
      aws_cli+=( --profile "$AWS_PROFILE" )
    fi
    account_id="$("${aws_cli[@]}" sts get-caller-identity --query Account --output text)"
    echo "Logging in to ECR ${account_id} (${aws_region})..."
    "${aws_cli[@]}" ecr get-login-password --region "$aws_region" \
      | docker login --username AWS --password-stdin "${account_id}.dkr.ecr.${aws_region}.amazonaws.com"

    echo "Building ${repo}:{{tag}} from web/..."
    docker build \
      --platform linux/amd64 \
      --provenance=false \
      --sbom=false \
      -t "${repo}:{{tag}}" \
      "$root/web"
    docker push "${repo}:{{tag}}"

    if [[ "{{tag}}" != "latest" ]]; then
      docker tag "${repo}:{{tag}}" "${repo}:latest"
      docker push "${repo}:latest"
    fi

    echo "Pushed ${repo}:{{tag}}"
