#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

## fmt: terraform fmt
function task_fmt {
  terraform fmt -recursive .
}

## fmt-check: check formatting
function task_fmt_check {
  terraform fmt -recursive -check .
}

## lint: init + validate modules / env
function task_lint {
  pushd modules/apprunner_web >/dev/null
  terraform init -reconfigure -backend=false >/dev/null
  terraform validate
  popd >/dev/null
}

## plan: terraform plan for env (default: dev)
function task_plan {
  local env=${1:-dev}
  pushd "env/$env" >/dev/null
  terraform init -reconfigure
  terraform plan
  popd >/dev/null
}

## apply: terraform apply for env (default: dev)
function task_apply {
  local env=${1:-dev}
  pushd "env/$env" >/dev/null
  terraform init -reconfigure
  terraform apply
  popd >/dev/null
}

## apply-auto: terraform apply -auto-approve (CI/CD)
function task_apply_auto {
  local env=${1:-dev}
  pushd "env/$env" >/dev/null
  terraform init -reconfigure
  terraform apply -auto-approve
  popd >/dev/null
}

## outputs: show outputs for env (prints APP_URL when App Runner is enabled)
function task_outputs {
  local env=${1:-dev}
  pushd "env/$env" >/dev/null
  terraform init -reconfigure >/dev/null
  terraform output
  local url
  url="$(terraform output -raw service_url 2>/dev/null || true)"
  if [[ -n "$url" && "$url" != "null" ]]; then
    echo ""
    echo "APP_URL=${url}"
    echo "Open: ${url}"
  else
    echo ""
    echo "APP_URL=(not deployed — set enable_apprunner=true and apply after push-image)"
  fi
  popd >/dev/null
}

## create-databases: CREATE DATABASE signalfold_dev / signalfold_prod on shared RDS
function task_create_databases {
  bash "$ROOT/scripts/create_databases.sh"
}

## upsert-google-oauth: put GOOGLE_* from web/.env into Secrets Manager (console-managed thereafter)
function task_upsert_google_oauth {
  python3 "$ROOT/scripts/upsert_google_oauth_secret.py"
}

## push-image: build and push web image to ECR (requires prior apply for repo)
function task_push_image {
  bash "$ROOT/scripts/push_image.sh"
}

## help: list tasks
function task_help {
  grep -E '^## ' "$0" | sed 's/^## /  /'
}

TASK="${1:-help}"
shift || true
"task_${TASK//-/_}" "$@"
